# --- Secrets (dev local uniquement ; en Docker ils viennent de ./secrets/) ---
# SECRET_KEY=
# SECRET_ENCRYPTION_KEY=

# --- Application ---
APP_BASE_URL=http://localhost:8000
ALLOW_REGISTRATION=true
SESSION_COOKIE_SECURE=false
# HOST_PORT=8000

# --- Planificateur ---
SCHEDULER_ENABLED=true
SCHEDULE_DAY_OF_WEEK=mon-sat
SCHEDULE_HOUR=8-19
TIMEZONE=Europe/Paris
DEFAULT_CHECK_INTERVAL_MINUTES=5
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_SECONDS=240
MAX_SIGN_RETRIES=3
SCREENSHOT_RETENTION_DAYS=7

# --- Code upstream (dev local) ---
# CNAMSIGN_PATH=./vendor/CnamSign
# HEADLESS=true

# --- Relais SMTP global (recommandé) ---
# Sans SMTP_HOST, chaque utilisateur s'envoie ses notifications via smtp.office365.com:587
# avec son compte Le Cnam (nécessite que l'authentification SMTP soit autorisée sur ce compte).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=CnamSign <noreply@example.org>
# SMTP_USE_TLS=true
